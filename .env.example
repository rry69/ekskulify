# Salin file ini menjadi .env, lalu isi sesuai lingkungan (JANGAN commit .env)
DB_TYPE=sqlite
# for mysql production: DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=ekskul
DB_USER=root
DB_PASS=
# Kunci aplikasi. Generate dengan: php -r "echo bin2hex(random_bytes(32));"
# Simpan hasilnya di .env (APP_KEY) atau api/.app_key — bukan di file contoh ini.
APP_KEY=
# Paksa redirect HTTP -> HTTPS (1 = aktif, 0 = nonaktif). Aktifkan di produksi.
APP_FORCE_HTTPS=0
# Daftar origin yang diizinkan (CORS), pisahkan dengan koma. Contoh: https://a.com,https://b.com
APP_ORIGIN=
# ==== Scaling / Multi-instance (Opsi A scale-ready) ====
# SESSION_DRIVER=file|db   (db = session di MySQL, wajib untuk multi-instance tanpa Redis)
SESSION_DRIVER=file
SESSION_TTL=2592000
# CACHE_DRIVER=auto|file|redis
CACHE_DRIVER=auto
# RATE_LIMIT_DRIVER=file|redis  (redis butuh ekstensi phpredis)
RATE_LIMIT_DRIVER=file
# STORAGE_DIR default: api/uploads (untuk multi-instance: arahkan ke shared/object storage)
# STORAGE_DIR=/var/www/shared/uploads
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# APP_ENV=production|dev|local (dev membuka flag dummy di api/index.php)
APP_ENV=production
# APP_BASE_URL untuk URL absolut (QR/sertifikat). Kosong = auto dari request.
APP_BASE_URL=
# ALLOW_DEBUG_IP CSV untuk guard api/check_approval.php (debug, jangan isi di prod)
ALLOW_DEBUG_IP=
